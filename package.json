{
  "name": "write-notes",
  "version": "0.2.0",
  "type": "module",
  "description": "Agent Notes 架构决策记录与门禁规范，面向 AI Agent 与工程团队的决策护栏体系",
  "bin": {
    "write-notes": "./bin/cli.js"
  },
  "files": [
    "bin",
    "scripts",
    "templates",
    "references",
    "SKILL.md",
    "LICENSE"
  ],
  "author": "IIwate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IIwate/write-notes.git"
  },
  "homepage": "https://github.com/IIwate/write-notes#readme",
  "bugs": {
    "url": "https://github.com/IIwate/write-notes/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "ai",
    "adr",
    "rfc",
    "guardrails",
    "notes",
    "architecture",
    "cli"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "verify-notes": "npx tsx scripts/verify-agent-note-tree.ts && npx tsx scripts/verify-agent-note-format.ts && npx tsx scripts/verify-doc-refs.ts && npx tsx scripts/verify-doc-typecheck.ts && npx tsx scripts/verify-type-equiv.ts && npx tsx scripts/verify-archived-notes.ts",
    "verify-tree": "npx tsx scripts/verify-agent-note-tree.ts",
    "verify-format": "npx tsx scripts/verify-agent-note-format.ts",
    "verify-doc-refs": "npx tsx scripts/verify-doc-refs.ts",
    "verify-typecheck": "npx tsx scripts/verify-doc-typecheck.ts",
    "verify-type-equiv": "npx tsx scripts/verify-type-equiv.ts",
    "archive-note": "npx tsx scripts/archive-agent-note.ts",
    "verify-archives": "npx tsx scripts/verify-archived-notes.ts",
    "note-refs": "npx tsx scripts/note-references.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.23.13",
    "typescript": "5.8.2"
  }
}
